# Пример конфигурации. Скопируйте этот файл в .env и укажите свой ключ.
# ВНИМАНИЕ: файл .env с реальным ключом никогда не коммитьте в Git (он уже в .gitignore).

# Какой провайдер использовать: gemini | openai | ollama
# Если не указан, агент выберет первый, для которого задан ключ.
LLM_PROVIDER=gemini

# Google Gemini (бесплатный ключ: https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
# Какие модели отвечают прямо сейчас: python -m tz_auditor.check
# Резервные модели: если основная перегружена (503) или недоступна (404), агент переключится сам
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-2.5-pro,gemini-3.5-flash-lite

# OpenAI или любой OpenAI-совместимый сервис
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=

# Локальная модель через Ollama (документ не покидает компьютер)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:14b

# Тонкая настройка (можно не трогать)
# LLM_TEMPERATURE=0.2
# LLM_MIN_INTERVAL_SEC=4      # пауза между запросами: бережёт бесплатный лимит Gemini
# LLM_MAX_RETRIES=5
# LLM_CACHE_DIR=.cache/llm
